app.post("/api/chat", async (req, res) => {
  try {
    const { message, history = [] } = req.body;

    if (typeof message !== "string" || !message.trim()) {
      return res.status(400).json({ error: "Message is required." });
    }

    // Keep conversation history small and accept only
    // user/assistant messages from the client.
    const safeHistory = Array.isArray(history)
      ? history
          .filter(
            (item) =>
              ["user", "assistant"].includes(item.role) &&
              typeof item.content === "string"
          )
          .slice(-10)
          .map(({ role, content }) => ({ role, content }))
      : [];

    const response = await fetch(
      "http://127.0.0.1:11434/api/chat",
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          model: "qwen3:0.6b",
          stream: false,
          messages: [
            {
              role: "system",
              content:
                "You are a helpful local AI assistant. Be accurate and concise."
            },
            ...safeHistory,
            { role: "user", content: message.trim() }
          ]
        })
      }
    );

    if (!response.ok) {
      throw new Error(`Ollama returned HTTP ${response.status}`);
    }

    const data = await response.json();

    res.json({ reply: data.message?.content ?? "" });
  } catch (error) {
    console.error("Chat error:", error.message);
    res.status(502).json({
      error: "Could not get a response from the local model."
    });
  }
});


const oauthClient = new google.auth.OAuth2(
  process.env.GOOGLE_CLIENT_ID,
  process.env.GOOGLE_CLIENT_SECRET,
  process.env.GOOGLE_REDIRECT_URI
);

const GMAIL_SCOPE = [
  "https://www.googleapis.com/auth/gmail.readonly"
];

// Local development only: keep the token in server memory.
// Restarting the backend requires authorizing again.
let gmailTokens = null;

function getGmailClient() {
  if (!gmailTokens) {
    throw new Error("Gmail is not connected.");
  }

  oauthClient.setCredentials(gmailTokens);

  return google.gmail({
    version: "v1",
    auth: oauthClient
  });
}



let oauthState = null;

app.get("/auth/gmail", (req, res) => {
  oauthState = randomBytes(32).toString("hex");

  const url = oauthClient.generateAuthUrl({
    access_type: "offline",
    prompt: "consent",
    scope: GMAIL_SCOPE,
    state: oauthState
  });

  res.redirect(url);
});

app.get("/auth/gmail/callback", async (req, res) => {
  const { code, state, error } = req.query;

  if (error) {
    oauthState = null;
    return res.status(400).send("Google authorization was denied.");
  }

  const expected = Buffer.from(oauthState || "");
  const received = Buffer.from(String(state || ""));

  if (
    !oauthState ||
    expected.length !== received.length ||
    !timingSafeEqual(expected, received)
  ) {
    oauthState = null;
    return res.status(400).send("Invalid OAuth state.");
  }

  oauthState = null;

  try {
    const { tokens } = await oauthClient.getToken(String(code));
    gmailTokens = tokens;
    oauthClient.setCredentials(tokens);

    res.send(
      "Gmail connected successfully. You can return to your assistant."
    );
  } catch (err) {
    console.error("OAuth error:", err.message);
    res.status(500).send("Gmail authorization failed.");
  }
});


app.listen(3002, () => {
  console.log("Backend running at http://localhost:3002");
});
